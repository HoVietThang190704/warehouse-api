# Database connection string (PostgreSQL / Neon Cloud)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# JWT Secrets for Authentication
JWT_SECRET="your_jwt_secret_key_at_least_32_characters"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_at_least_32_characters"
REFRESH_TOKEN_EXPIRATION="7d"

# Cloudinary Storage for Catalog Images
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Ports & Internal Service Routing
PORT=3000
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
IDENTITY_SERVICE_URL="http://localhost:3001"
CATALOG_SERVICE_URL="http://localhost:3002"
INVENTORY_SERVICE_URL="http://localhost:3003"

# Production Frontend URL for CORS (e.g. https://your-app.vercel.app)
FRONTEND_URL=""
