{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build:vercel",
  "builds": [
    {
      "src": "dist/apps/api-gateway/serverless.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/apps/api-gateway/serverless.js"
    }
  ]
}
